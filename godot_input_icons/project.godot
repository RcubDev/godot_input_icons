config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="godot_input_icons"
run/main_scene="uid://cipb74td5x87b"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputHelper="*uid://cholww48njaeh"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="godot_input_icons"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_input_icons/plugin.cfg", "res://addons/input_helper/plugin.cfg")

